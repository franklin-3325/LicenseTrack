# Copy this file to .env and fill in the values.
# .env is never committed to git (it's in .gitignore) - that's where secrets belong.

# The Postgres database LicenseTrack stores its data in. Get a free one in about
# a minute from https://neon.com or https://www.prisma.io/postgres (no credit card),
# or add "Postgres" from Vercel's Storage tab when you deploy - see README.md.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional, but strongly recommended if DATABASE_URL is a pooled connection
# (Neon/Supabase/etc. connection strings with "-pooler" or "pgbouncer" in them).
# Set this to the same provider's "direct"/"unpooled" connection string -
# migrations need it. Leave blank if DATABASE_URL isn't pooled (e.g. local Postgres).
DIRECT_URL=""

# Used to securely sign in-browser login sessions. Generate your own with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Optional (for now): powers "your license expires soon" reminder emails.
# Leave blank and the app still works - reminders just get logged instead of emailed.
# Get a free key at https://resend.com after verifying a sending domain (or use their
# shared onboarding@resend.dev sender for testing).
RESEND_API_KEY=""
EMAIL_FROM="LicenseTrack <onboarding@resend.dev>"

# A random secret only you and your scheduler (e.g. Vercel Cron) know, so nobody
# else can trigger the reminder-email job. Generate with: openssl rand -hex 16
CRON_SECRET=""

# Optional (for now): powers uploading license/insurance/bond documents.
# Leave blank and the app still works - uploads just show a friendly error instead
# of crashing. On Vercel: Storage tab -> Create Database -> Blob - the
# BLOB_READ_WRITE_TOKEN below gets set automatically once it's connected to your
# project. For local dev, copy that same token here.
BLOB_READ_WRITE_TOKEN=""
